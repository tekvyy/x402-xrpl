{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @app/gateway... build",
    "watchPatterns": [
      "packages/gateway/**",
      "packages/shared/**",
      "migrations/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.base.json",
      "railway.gateway.json"
    ]
  },
  "deploy": {
    "startCommand": "pnpm migrate:up && pnpm --filter @app/gateway start",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1
  }
}
