# XRPL network selector: MAINNET | TESTNET
XRPL_NETWORK=TESTNET
# Override the default JSON-RPC/WebSocket endpoint for the selected network (optional)
XRPL_ENDPOINT=wss://s.altnet.rippletest.net:51233
# Family seed for the gateway's own XRPL wallet (funds settlements, redeems channels)
GATEWAY_XRPL_SEED=sEdSTUBSEEDREPLACEME00000000000000
# Secret for signing dashboard session tokens (sign-in-with-XRPL). >= 16 chars.
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-64-character-random-hex-secret
# Source tag stamped on every gateway-submitted XRPL transaction (XRPL Commons leaderboard)
SOURCE_TAG=1080108
# RLUSD issuer classic address on the selected network
RLUSD_ISSUER=rQhWct2fv4Vc4KRjRgMrxa8xPN9Zx9iLKV
# Postgres connection string for durable ledger/usage/sellers
DATABASE_URL=postgres://postgres:postgres@localhost:5432/xrpl_gateway
# Redis connection string for rate limit, sign-in challenges, live-feed pub/sub
REDIS_URL=redis://localhost:6379
# Port the gateway HTTP service listens on
GATEWAY_PORT=8402
# Allowed origin for the seller dashboard (CORS)
DASHBOARD_ORIGIN=http://localhost:5173
# Enable the custodial escrow-credits fallback (US-004 demo insurance). Off by
# default; the authentic prepaid path is XRPL PayChan. true | false
ESCROW_ENABLED=false
# Platform fee in basis points (100 = 1%) taken on the PayChan credits path. When
# prepaid channels are opened to the gateway, which redeems on chain and
# forwards the seller's cut minus this fee. 0 (default) forwards the full amount.
# Max 10000 (100%).
PLATFORM_FEE_BPS=0
# Honor X-Forwarded-For from a fronting reverse proxy so per-IP rate limits key
# on the real client. Only enable when actually behind a trusted proxy.
TRUST_PROXY=false
# Comma-separated XRPL classic addresses granted admin access (audit-log
# endpoints). Admins sign in through the normal wallet auth flow; membership in
# this list is what elevates the session. Empty/unset = no admins.
# ADMIN_ADDRESSES=rAdminAddress1,rAdminAddress2

# --- Dashboard (Vite build-time) wallet adapters, optional ---
# GemWallet + Crossmark work with no config. Set these to enable the others.
# Xaman API key (https://apps.xumm.dev/)
# VITE_XAMAN_API_KEY=
# WalletConnect project id (https://cloud.walletconnect.com/)
# VITE_WALLETCONNECT_PROJECT_ID=
