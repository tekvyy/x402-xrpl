{
  "name": "xrpl-x402-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migrate:up": "node-pg-migrate up -m migrations -j sql",
    "migrate:down": "node-pg-migrate down -m migrations -j sql",
    "demo": "node scripts/demo.mjs",
    "login": "node scripts/login.mjs",
    "audit:source-tag": "pnpm --filter @app/gateway audit:source-tag"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "node-pg-migrate": "^7.9.0",
    "pg": "^8.13.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
